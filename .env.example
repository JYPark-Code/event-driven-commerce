# 시크릿 외부화 (보안 하드닝 — docs/decisions.md 23번)
#
# 모든 값에 로컬 데모 기본값이 있어 이 파일 없이도 그대로 실행된다.
# 기본값을 덮어쓰려면: cp .env.example .env 후 값 입력 (.env는 gitignore 대상 — 커밋 금지).
#
# 적용 범위가 다르다:
#  - docker compose는 .env를 자동으로 읽는다.
#  - Spring 앱은 호스트에서 직접 실행되므로 .env를 읽지 않는다 — 셸 환경변수로 주입한다.
#    PowerShell 예: $env:JWT_SECRET = "..."; java -jar backoffice-app/...jar
#
# 짝이 맞아야 하는 값:
#  - MYSQL_PASSWORD(컨테이너) = DB_PASSWORD(앱)
#  - INTERNAL_API_TOKEN은 order-app과 backoffice-app에 같은 값 — 다르면 정산이 401로 실패

# ── docker-compose가 읽는 값 ──
MYSQL_ROOT_PASSWORD=root1234
MYSQL_USER=tps
MYSQL_PASSWORD=tps1234
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin1234

# ── Spring 앱이 읽는 값 (셸 환경변수로 주입) ──
DB_USERNAME=tps
DB_PASSWORD=tps1234
JWT_SECRET=tps1000-demo-jwt-secret-key-do-not-use-in-production-0123456789
BACKOFFICE_ADMIN_PASSWORD=admin1234!
INTERNAL_API_TOKEN=tps1000-internal-demo-token
